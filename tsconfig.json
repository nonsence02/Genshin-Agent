{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "jsx": "react-jsx",
    "types": ["node", "vitest", "vite/client"]
  },
  "include": ["src/**/*.ts", "apps/web/src/**/*.ts", "apps/web/src/**/*.tsx", "tests/**/*.ts", "tests/**/*.tsx", "vitest.config.ts", "prisma.config.ts"]
}
